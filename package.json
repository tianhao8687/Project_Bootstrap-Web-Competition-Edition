{
  "name": "project-bootstrap-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/run-e2e.mjs",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "evaluate:real": "tsx scripts/evaluate-real-model.ts",
    "smoke:deployment": "node scripts/smoke-deployment.mjs",
    "sync-core": "node scripts/sync-core.mjs",
    "verify-core": "node scripts/verify-core-snapshot.mjs"
  },
  "dependencies": {
    "jszip": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-markdown": "latest",
    "rehype-sanitize": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@testing-library/user-event": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vercel/node": "latest",
    "@vitejs/plugin-react": "latest",
    "jsdom": "latest",
    "typescript": "latest",
    "tsx": "latest",
    "vite": "latest",
    "vitest": "latest"
  }
}
